{
  "name": "@step-security/markdownlint-cli2-action",
  "private": true,
  "version": "25.0.0",
  "description": "A GitHub Action to run the markdownlint-cli2 tool for linting Markdown/CommonMark files with the markdownlint library",
  "author": "step-security",
  "publisher": "step-security",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/step-security/markdownlint-cli2-action.git"
  },
  "scripts": {
    "build": "ncc build markdownlint-cli2-action.mjs",
    "lint": "eslint *.mjs package.json --max-warnings 0 && markdownlint-cli2 *.md",
    "test": "npm run lint && npm run build && git diff --exit-code"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "axios": "^1.20.0",
    "markdownlint-cli2": "^0.24.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.12.0",
    "eslint-package-json": "3.0.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-unicorn": "78.0.0"
  },
  "keywords": [
    "markdown",
    "lint",
    "md",
    "commonmark",
    "markdownlint"
  ],
  "homepage": "https://github.com/step-security/markdownlint-cli2-action#readme",
  "bugs": {
    "url": "https://github.com/step-security/markdownlint-cli2-action/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
